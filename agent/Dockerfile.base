FROM node:22-alpine

# Create non-root user
# node:22-alpine has uid 1000 as 'node' — reuse it as agent user
RUN deluser --remove-home node 2>/dev/null; \
    addgroup -S agent && adduser -S agent -G agent -u 1000

WORKDIR /app

# Install deps at build time — remove cache in same layer to keep image lean
COPY package*.json ./
RUN npm ci --ignore-scripts --cache /tmp/npm-cache && rm -rf /tmp/npm-cache

# Copy source
COPY src/ ./src/
COPY tsconfig.json ./

RUN npx tsc && rm -rf src/ tsconfig.json

# Mount points: /app/agent (profile, read-only bind), /app/workspace (tmpfs), /tmp (tmpfs)
RUN mkdir -p /app/agent /app/workspace /tmp && chown agent:agent /app/agent /app/workspace

USER agent

ENTRYPOINT ["node", "dist/entrypoint.js"]
