{
  "name": "talos-vscode",
  "displayName": "Talos",
  "description": "View, edit, and navigate your Talos exocortex from VS Code.",
  "version": "0.1.0",
  "private": true,
  "publisher": "talos",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "talos",
          "title": "Talos",
          "icon": "$(database)"
        }
      ]
    },
    "views": {
      "talos": [
        {
          "id": "talos.entries",
          "name": "Entries"
        }
      ]
    },
    "commands": [
      {
        "command": "talos.setApiKey",
        "title": "Talos: Set API Key"
      },
      {
        "command": "talos.clearApiKey",
        "title": "Talos: Clear API Key"
      },
      {
        "command": "talos.ping",
        "title": "Talos: Ping Server"
      },
      {
        "command": "talos.refresh",
        "title": "Talos: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "talos.openEntry",
        "title": "Talos: Open Entry"
      },
      {
        "command": "talos.navigateBack",
        "title": "Talos: Back",
        "icon": "$(arrow-left)",
        "enablement": "talos.canNavigateBack"
      },
      {
        "command": "talos.navigateForward",
        "title": "Talos: Forward",
        "icon": "$(arrow-right)",
        "enablement": "talos.canNavigateForward"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "talos.refresh",
          "when": "view == talos.entries",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "talos.navigateBack",
          "when": "activeWebviewPanelId == talos.entry",
          "group": "navigation@1"
        },
        {
          "command": "talos.navigateForward",
          "when": "activeWebviewPanelId == talos.entry",
          "group": "navigation@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "talos.navigateBack",
        "key": "alt+left",
        "when": "activeWebviewPanelId == talos.entry"
      },
      {
        "command": "talos.navigateForward",
        "key": "alt+right",
        "when": "activeWebviewPanelId == talos.entry"
      }
    ],
    "configuration": {
      "title": "Talos",
      "properties": {
        "talos.serverUrl": {
          "type": "string",
          "default": "http://localhost:3001/mcp",
          "description": "URL of the Talos MCP server."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.webview.json"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0"
  }
}
